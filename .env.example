# These secrets are read only by the server/CLI, never the browser.
GROQ_API_KEY=
# Select an active Groq chat model supporting JSON object output.
GROQ_MODEL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=demoshop_minilm_v1
# Used only for local experiments when QDRANT_URL is empty.
QDRANT_PATH=./qdrant_data
TOP_K=4
MIN_SCORE=0.35
REQUESTS_PER_MINUTE=10
MAX_CONCURRENT_REQUESTS=2
# Optional ingestion-only source folder:
# DOCUMENTS_DIR=C:/my-documents/demoshop
